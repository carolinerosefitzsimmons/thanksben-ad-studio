# Copy to .env.local and fill in. Nothing here is read at build time — only at runtime.

# --- Required ---
SUPABASE_DB_URL=postgresql://...   # Postgres. The app runs supabase/legora_schema.sql itself on first query.
ANTHROPIC_API_KEY=                 # Claude. Firm research (Haiku 4.5) + ad & landing copy (Sonnet 5).
OPENAI_API_KEY=                    # OpenAI. gpt-image-2 renders the ad. Without it /api/generate returns 400.

# --- Recommended ---
FIRECRAWL_KEY=                     # Firm-website scrape. Without it, falls back to plain fetch + tag-strip,
                                   # which is markedly worse on JS-rendered firm sites.
LOGO_DEV_TOKEN=                    # Real peer-firm wordmarks. Without it logos degrade to Google favicons,
                                   # which look poor composited into an ad. (Was missing from the original template.)

# --- Not read by the application ---
# PARALLEL_KEY / EXA_KEY appeared in the original template but no code reads them.
# They were used once, by hand, to harvest data/legora_clients.json — see data/HARVEST_NOTES.md.
