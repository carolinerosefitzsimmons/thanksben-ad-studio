# Copy to .env.local and fill in. Nothing here is read at build time — only at runtime.

# ─── Required ────────────────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql://...   # Postgres. The app applies supabase/schema.sql itself.
ANTHROPIC_API_KEY=                 # Claude. Research (Haiku 4.5) + ad & landing copy (Sonnet 5).
OPENAI_API_KEY=                    # OpenAI. gpt-image-2 renders the ad.

# ─── Access control ──────────────────────────────────────────────────────────
# HTTP Basic auth over the whole studio. REQUIRED in production — the app returns
# 503 without them rather than sitting open, because every run costs money.
# /lp/* landing pages stay public by design, so they can be sent to a prospect.
APP_USER=
APP_PASSWORD=

# ─── Spend controls ──────────────────────────────────────────────────────────
# Every selected market is one billable gpt-image-2 render.
MAX_ADS_PER_REQUEST=4              # default 4
DAILY_AD_LIMIT=50                  # default 50, counted from midnight UTC

# ─── Image storage ───────────────────────────────────────────────────────────
# With both set, ad images go to Supabase Storage. Without them they go to local
# disk under .data/ads, which is fine for development but NOT for production
# (not shared between instances, lost on redeploy).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ad-images  # must exist; create it in the Supabase dashboard

# ─── Recommended ─────────────────────────────────────────────────────────────
FIRECRAWL_KEY=                     # Prospect-website scrape. Without it, falls back to a
                                   # plain fetch + tag-strip, much worse on JS-rendered sites.
LOGO_DEV_TOKEN=                    # Real customer wordmarks. Without it logos fall back to
                                   # Google favicons, which look poor composited into an ad.

# ─── Escape hatches ──────────────────────────────────────────────────────────
# PGSSL_NO_VERIFY=1                # Skip database TLS verification. Last resort only.
